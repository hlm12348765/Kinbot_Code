root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,cc,h,hpp,c}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{proto,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = space
indent_size = 2
